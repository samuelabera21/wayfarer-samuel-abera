{
  "name": "wayfarer",
  "version": "1.0.0",
  "private": true,
  "description": "Wayfarer — City discovery with honest Bayesian ratings and concurrency-safe tour booking",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm --prefix backend test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "seed": "npm --prefix backend run seed",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm --prefix frontend run lint"
  }
}

